{
  "entities": {
    "reservation": {
      "title": "Reservation",
      "description": "Table reservation details",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "pattern": "^[+]?[(]?[0-9]{3}[)]?[-s.]?[0-9]{3}[-s.]?[0-9]{4,6}$" },
        "guests": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "requests": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "phone", "guests", "date", "time"]
    },
    "review": {
      "title": "Review",
      "description": "Customer feedback and ratings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "rating", "text"]
    },
    "menuItem": {
      "title": "Menu Item",
      "description": "Details of a menu dish",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string" },
        "price": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string" },
        "minPickupTime": { "type": "string", "enum": ["15 min", "30 min", "1 hr"] },
        "available": { "type": "boolean" }
      },
      "required": ["name", "category", "price"]
    },
    "order": {
      "title": "Order",
      "description": "Customer pickup order",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string" },
        "pickupTime": { "type": "string" },
        "total": { "type": "number" },
        "items": { "type": "array", "items": { "type": "object" } },
        "notes": { "type": "string", "maxLength": 500 },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "phone", "pickupTime", "total", "items"]
    }
  },
  "firestore": {
    "/reservations/{reservationId}": {
      "schema": "reservation",
      "description": "Collection of table reservations"
    },
    "/reviews/{reviewId}": {
      "schema": "review",
      "description": "Collection of customer reviews"
    },
    "/menu/{itemId}": {
      "schema": "menuItem",
      "description": "Collection of menu items"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Collection of customer orders"
    }
  }
}
